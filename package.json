{
  "name": "tiny-csv",
  "version": "0.1.0",
  "description": "Strict RFC 4180 CSV parser and serializer. Zero dependencies.",
  "keywords": [
    "csv",
    "minimal",
    "parse",
    "rfc4180",
    "stringify"
  ],
  "homepage": "https://github.com/outslept/tiny-csv#readme",
  "bugs": {
    "url": "https://github.com/outslept/tiny-csv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outslept/tiny-csv.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    }
  }
}
